# 📍 /.env.example

# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Property Marketplace"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ─── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_USER=property_user
POSTGRES_PASSWORD=property_pass_dev
POSTGRES_DB=property_marketplace
POSTGRES_PORT=5432
DATABASE_URL="postgresql://property_user:property_pass_dev@localhost:5432/property_marketplace?schema=public"

# ─── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ─── JWT Authentication ──────────────────────────────────────
# Production-এ অবশ্যই 64+ character random string দাও
JWT_ACCESS_SECRET="I+rLUBTb/Dz8/yVCvBtmbxKcmUX1kka4vpWWs2JJl3ti+Gccb4m8U+QjCvVTWcmbZ0powyeU2mhll1NPawu2Nw=="
JWT_REFRESH_SECRET="WmltI+mKMDpSx8AB8wMxHpYikrWap3s2BERyIsfW2xvFzQjqwPmsDIWjbSSS2G5FqDIUTDMvQn//JWmjgJPGQQ=="
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Cookie ──────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ─── File Storage (S3-compatible; local dev-এ MinIO) ─────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=property-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/property-images

# ─── Upload Limits ───────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_IMAGES_PER_PROPERTY=20

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="noreply@propertymarketplace.local"
SMTP_FROM_NAME="Property Marketplace"

# ─── OTP (SMS) — Phase 5-এ ব্যবহার হবে ───────────────────────
SMS_PROVIDER=console
SMS_API_KEY=

# ─── Admin Default Seed ──────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME="Super Admin"

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SITE_NAME="Property Marketplace"