    "@nestjs/swagger": "^8.1.0",
    "@prisma/client": "^6.1.0",
    "@property-marketplace/shared-types": "workspace:*",
    "@property-marketplace/validation": "workspace:*",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.2.0",
    "nestjs-zod": "^4.1.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "argon2": "^0.41.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "socket.io": "^4.8.1"
