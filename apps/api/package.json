
{
  "name": "@property-marketplace/api",
  "version": "0.2.0",
  "private": true,
  "description": "Property Marketplace NestJS API",
  "type": "commonjs",
  "main": "dist/main.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo Lint setup pending",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['dist','.turbo'])fs.rmSync(p,{recursive:true,force:true})\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@property-marketplace/shared-types": "workspace:*",
    "@property-marketplace/validation": "workspace:*",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/platform-socket.io": "^12.5.1",
    "@nestjs/websockets": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/bullmq": "^12.0.2",
    "@prisma/client": "6.19.3",
    "@aws-sdk/client-s3": "^3.700.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.6.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "multer": "^2.0.0",
    "sharp": "^0.34.0",
    "socket.io": "4.8.4",
    "nodemailer": "^7.0.0",
    "bullmq": "^5.0.0"
  },
  "devDependencies": {
    "@property-marketplace/typescript-config": "workspace:*",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.5.1",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "tsx": "^4.20.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "@types/node": "^26.6.6",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/passport-jwt": "^4.0.1",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^7.0.0",
    "pino-pretty": "^13.0.0"
  }
}
