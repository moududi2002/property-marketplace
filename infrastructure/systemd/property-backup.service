# 📍 /infrastructure/systemd/property-backup.service
# Copy to: /etc/systemd/system/property-backup.service

[Unit]
Description=Property Marketplace Daily Backup
After=network.target postgresql.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/property-marketplace
ExecStart=/bin/bash /opt/property-marketplace/infrastructure/scripts/backup.sh
StandardOutput=journal
StandardError=journal