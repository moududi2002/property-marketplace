
{
  "name": "property-marketplace",
  "version": "0.2.0",
  "private": true,
  "description": "Bangladesh Property Marketplace",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=9.0.0 <13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @property-marketplace/web dev",
    "dev:api": "pnpm --filter @property-marketplace/api dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "clean": "turbo run clean",
    "db:up": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml down",
    "db:logs": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter @property-marketplace/api prisma:generate",
    "db:migrate": "pnpm --filter @property-marketplace/api prisma:migrate",
    "db:seed": "pnpm --filter @property-marketplace/api prisma:seed",
    "db:studio": "pnpm --filter @property-marketplace/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9"
  }
}
