# 📍 /.env.production.example
#
# Production environment variables. Copy to `.env` on the server and
# fill in real values. NEVER commit the real .env.
#
# Generate secrets with:  openssl rand -base64 64

# ─── Application ──────────────────────────────────────────
NODE_ENV=production
PORT=4035
APP_NAME="Property Marketplace"
APP_URL=https://example.com
API_URL=https://example.com
NEXT_PUBLIC_API_URL=https://example.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://example.com
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SITE_NAME="Property Marketplace"

# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=property_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=property_marketplace
POSTGRES_PORT=5432
DATABASE_URL="postgresql://property_prod:CHANGE_ME_STRONG_PASSWORD@localhost:5432/property_marketplace?schema=public&connection_limit=20"

# ─── Redis ────────────────────────────────────────────────
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379"

# ─── JWT (minimum 64 chars each) ──────────────────────────
JWT_ACCESS_SECRET=PASTE_OUTPUT_OF_openssl_rand_base64_64
JWT_REFRESH_SECRET=PASTE_OUTPUT_OF_openssl_rand_base64_64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cookies ──────────────────────────────────────────────
COOKIE_DOMAIN=example.com
COOKIE_SECURE=true

# ─── S3 / Storage ─────────────────────────────────────────
# Option A: AWS S3 / DigitalOcean Spaces (recommended for prod)
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=your-prod-bucket
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://your-prod-bucket.nyc3.cdn.digitaloceanspaces.com

# Option B: Self-hosted MinIO (uncomment & comment A)
# S3_ENDPOINT=https://storage.example.com
# S3_REGION=us-east-1
# S3_BUCKET=property-images
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://storage.example.com/property-images

# ─── Upload Limits ────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_IMAGES_PER_PROPERTY=20

# ─── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_SMTP_KEY
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_FROM_NAME="Property Marketplace"

# ─── SMS (Phase 2) ────────────────────────────────────────
SMS_PROVIDER=console
SMS_API_KEY=

# ─── Seed Admin (first deploy only) ───────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_ADMIN_NAME="Super Admin"